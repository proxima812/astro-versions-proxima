---
import { buildFooterText, getWidgetConfig } from "../runtime/config.mjs";

const config = getWidgetConfig();
const mode = Astro.props.styleMode ?? config.styling?.mode ?? "class";
const className = mode === "none" ? Astro.props.class : Astro.props.class ?? config.footer.class;
const style = mode === "inline" ? Astro.props.style ?? config.footer.style : Astro.props.style;
const text = buildFooterText(config, Astro.props);
---

<p class={className} style={style}>{text}</p>
