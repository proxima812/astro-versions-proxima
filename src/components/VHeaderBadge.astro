---
import { buildHeaderText, getWidgetConfig } from "../runtime/config.mjs";

const config = getWidgetConfig();
const mode = Astro.props.styleMode ?? config.styling?.mode ?? "class";
const className = mode === "none" ? Astro.props.class : Astro.props.class ?? config.header.class;
const style = mode === "inline" ? Astro.props.style ?? config.header.style : Astro.props.style;
const text = buildHeaderText(config, Astro.props);
---

<span class={className} style={style}>{text}</span>
